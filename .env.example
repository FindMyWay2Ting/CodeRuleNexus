POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowledge
POSTGRES_PORT=5433
DATABASE_URL=postgresql://knowledge:change-me@localhost:5433/knowledge

LLM_API_BASE=https://your-openai-compatible-host/v1
LLM_API_KEY=your-chat-api-key
CHAT_MODEL=your-chat-model

EMBEDDING_API_BASE=https://your-openai-compatible-host/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=1024

RERANKER_API_KEY=your-reranker-api-key
RERANKER_API_URL=https://your-rerank-host/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_MODEL=qwen3-rerank
RERANKER_CANDIDATE_LIMIT=20
CODE_AGENT_MAX_ROUNDS=10
CODE_AGENT_MAX_TOOL_CALLS=12
SCIP_PYTHON_IMAGE=sourcegraph/scip-python:v0.6.6
SCIP_PYTHON_TIMEOUT=300
# Code snapshots are persistent data. Use an absolute path outside the checkout
# when the same database must survive clean rebuilds or rolling releases.
CODE_REPOSITORY_ROOT=./data/code_repositories

WORKSPACE_ID=workspace-001
CURRENT_WORKSPACE_NAME=workspace-001
CURRENT_USER_ID=User
CURRENT_DEPARTMENT_ID=department-001
REGISTRATION_ENABLED=true
# Optional one-time code for claiming data created before user authentication existed.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEGACY_BOOTSTRAP_TOKEN=
SESSION_COOKIE_NAME=knowledge_session
CSRF_COOKIE_NAME=knowledge_csrf
# Local HTTP development uses false. Production HTTPS must use true.
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_MINUTES=720
ALLOW_SERVER_PATH_SCAN=false
MAX_CONTEXT_CHUNKS=8
PARENT_CHUNK_SIZE=2400
CHILD_CHUNK_SIZE=700
CHILD_CHUNK_OVERLAP=100
MAX_CONTEXT_TOKENS=6000

# Optional observability cost rates, per 1K tokens; keep 0 when pricing is unknown.
EMBEDDING_INPUT_COST_PER_1K_TOKENS=0
CHAT_INPUT_COST_PER_1K_TOKENS=0
CHAT_OUTPUT_COST_PER_1K_TOKENS=0
RERANKER_COST_PER_1K_TOKENS=0
